# Deze map bevat alleen server-side config (secrets.php, turnstile.php).
# Nooit rechtstreeks via de browser opvraagbaar, alleen via PHP's require()
# vanuit index.php/contact.php — dat gaat buiten de webserver om.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
